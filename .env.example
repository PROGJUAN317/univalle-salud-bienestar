# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio (ya está en .gitignore).

PORT=3000

# Base de datos.
#  - Local (docker compose): postgres://postgres:postgres@localhost:5432/univalle
#  - Neon: copia la cadena de conexión desde el panel de Neon (botón "Connect").
DATABASE_URL=

# Clave para firmar los tokens de sesión. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Solo para docker compose (contraseña del Postgres local).
POSTGRES_PASSWORD=postgres
